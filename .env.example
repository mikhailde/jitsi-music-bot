# ==========================================
# MAIN CONFIGURATION
# ==========================================
TELEGRAM_TOKEN=your_bot_token_from_botfather
PORT=3000
LANGUAGE=en
DEBUG_MODE=false
PROXY_URL=

# ==========================================
# TELEGRAM SECURITY
# ==========================================
# Comma-separated user IDs allowed to control the bot (e.g. 123456789,987654321)
# Leave empty to allow access for all users:
TELEGRAM_ADMIN_IDS=

# ==========================================
# JITSI CONFIGURATION
# ==========================================
JITSI_DOMAIN=meet.jit.si
BOT_NAME="DJ_Music_Bot"
BOT_AVATAR=https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=200&h=200&fit=crop
AUDIO_ONLY=true
P2P_ENABLED=false
PREJOIN_ENABLED=false

# ==========================================
# AUDIO & PLAYER CONFIGURATION
# ==========================================
DEFAULT_VOLUME=50
AUDIO_BITRATE=192k
OPUS_BITRATE=510000
HISTORY_LIMIT=5
QUEUE_PAGE_SIZE=5
RADIO_ITEMS_LIMIT=10

# ==========================================
# TIMEOUTS & BROWSER
# ==========================================
AFK_TIMEOUT_SEC=300
AFK_CHECK_INTERVAL_SEC=15
SHUTDOWN_TIMEOUT_SEC=3
HEADLESS_MODE=true
